{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "Local",
    "Upload": {
      "MaxBytes": 10485760,
      "AllowedContentTypes": [ "image/*", "application/pdf", "text/plain" ]
    },
    "Local": {
      "Path": "Files"
    }
  }
}
